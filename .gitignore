# Rust
/target
**/*.rs.bk

# Secrets — this project handles Cloudflare API tokens and WireGuard private
# keys. Keep them out of history; a leaked key is a leaked key even after a
# force-push.
.env
*.env
!.env.example
*.key
*.pem
wg*.conf
config.local.toml
# The deployed config names a zone and a VPS; the example stays, the real one
# does not.
deploy/config.toml

# Local state
/data
*.db
*.db-shm
*.db-wal
*.sqlite

# Editors / OS
/.idea
/.vscode
.claude/settings.local.json
.DS_Store
Thumbs.db
