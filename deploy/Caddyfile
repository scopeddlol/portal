# HTTPS in front of the control panel.
#
# The agent reaches the gateway's API over the internet, and the admin token
# protects the entire DNS zone, so it must not travel in the clear. Caddy
# fetches and renews the certificate on its own; the only requirement is that
# this name resolves to the server.

portal.example.com {
	reverse_proxy 127.0.0.1:8080
}
